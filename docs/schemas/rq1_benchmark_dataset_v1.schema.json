{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartmqtt.local/schemas/rq1_benchmark_dataset_v1.schema.json",
  "title": "SmartMQTT RQ1 benchmark dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "seed", "examples"],
  "properties": {
    "schema_version": {"const": "smartmqtt-rq1/v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stream_id", "topic", "tags", "label", "split",
          "source_id", "source_kind"
        ],
        "properties": {
          "stream_id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "tags": {"type": "object"},
          "fields": {"type": "object"},
          "schema": {"type": "object"},
          "label": {"type": "string", "minLength": 1},
          "split": {"enum": ["CALIBRATION", "VALIDATION", "TEST"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_kind": {"enum": ["CONTROLLED", "REAL"]},
          "duplicate_disposition": {
            "enum": ["CANONICAL", "CONFIRMED_ALIAS", "KEEP_BOTH"]
          },
          "canonical_stream_id": {"type": ["string", "null"]},
          "decision_source": {"enum": ["AUTOMATED", "HUMAN_CONFIRMED"]},
          "authoritative_label": {"type": ["string", "null"]}
        },
        "anyOf": [
          {"required": ["fields"]},
          {"required": ["schema"]}
        ]
      }
    }
  }
}
