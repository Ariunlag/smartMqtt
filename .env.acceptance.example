# Copy to .env.acceptance and replace every CHANGE_ME value before shared use.
# The repository's Compose defaults are intended only for isolated local work.
POSTGRES_DB=influxai
POSTGRES_USER=influxai
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DSN=postgresql://influxai:CHANGE_ME@postgres:5432/influxai

INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=CHANGE_ME
INFLUX_ORG=influxai
INFLUX_BUCKET=smartHub
INFLUX_TOKEN=CHANGE_ME

QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Acceptance-only operational bounds.
CLASS_RECOMMENDATION_QUEUE_MAXSIZE=128
INGEST_QUEUE_MAXSIZE=512
INGEST_WORKERS=16
DUPE_CHECK_DELAY=1
ID_THRESH=0.8
RECOVERY_BASE_DELAY=1.0
RECOVERY_MAX_DELAY=4.0
